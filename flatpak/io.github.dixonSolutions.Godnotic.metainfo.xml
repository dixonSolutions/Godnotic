<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.dixonSolutions.Godnotic</id>
  <name>Godnotic</name>
  <summary>Touch arena FPS for Linux phones, tablets and PCs</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.dixonsolutions">
    <name>dixonSolutions</name>
  </developer>
  <description>
    <p>
      Godnotic brings the fast-paced arena shooter Xonotic to Linux
      phones, tablets and touchscreen PCs. Virtual joysticks, weapon wheels, and
      layout presets are tuned for two-thumb play in landscape. A touchscreen
      is required; this build is not intended for keyboard-and-mouse play.
    </p>
    <p>
      The Flatpak is small at install (~60 MB). Textures, maps, and music
      download on first launch (~3 GB) so updates stay quick.
    </p>
    <p>
      The same game is also available for Android (APK) and Ubuntu Touch
      (OpenStore).
    </p>
  </description>
  <launchable type="desktop-id">io.github.dixonSolutions.Godnotic.desktop</launchable>
  <url type="homepage">https://github.com/dixonSolutions/Godnotic</url>
  <url type="bugtracker">https://github.com/dixonSolutions/Godnotic/issues</url>
  <url type="vcs-browser">https://github.com/dixonSolutions/Godnotic</url>
  <!-- CI (scripts/set-package-version.sh) adds a release per build at the top. -->
  <!-- GNOME Software and Discover load these by URL. -->
  <screenshots>
    <screenshot type="default">
      <caption>Two-thumb touch controls in a match</caption>
      <image type="source" width="1200" height="540">https://raw.githubusercontent.com/dixonSolutions/Godnotic/main/docs/media/hud-playing.jpg</image>
    </screenshot>
    <screenshot>
      <caption>Voting for the next map</caption>
      <image type="source" width="1200" height="540">https://raw.githubusercontent.com/dixonSolutions/Godnotic/main/docs/media/hud-mapvote.jpg</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">intense</content_attribute>
    <content_attribute id="violence-bloodshed">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
  <releases>
    <release version="1.1.1" date="2026-06-21">
      <description>
        <p>Flatpak-first distribution with runtime asset download and automated CI releases.</p>
      </description>
    </release>
  </releases>
</component>
